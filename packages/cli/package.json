{
  "name": "ionbit-ui",
  "version": "0.1.13",
  "description": "Ionbit UI CLI — install source-owned components from the Ionbit UI registry.",
  "type": "module",
  "license": "MIT",
  "author": "Rostislav Rudometov",
  "repository": {
    "type": "git",
    "url": "https://github.com/rostislaw9/ionbit-ui",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/rostislaw9/ionbit-ui#readme",
  "bugs": {
    "url": "https://github.com/rostislaw9/ionbit-ui/issues"
  },
  "keywords": [
    "cli",
    "react",
    "components",
    "ui",
    "design-system",
    "registry",
    "scaffold"
  ],
  "bin": "dist/index.js",
  "exports": {
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./utilities.css": "./dist/utilities.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
